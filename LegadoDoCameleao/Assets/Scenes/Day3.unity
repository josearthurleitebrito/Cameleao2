  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManager
  teclaInteracao: 101
  faseAtual: 2
  painelIntro: {fileID: 446348004}
  tempoDuracaoIntro: 5
  painelPause: {fileID: 596814120}
  painelGameOver: {fileID: 413195164}
  painelVitoria: {fileID: 184747742}
  totalObrasParaInspecionar: 2
  textoConclusaoFase1: "J\xE1 tenho provas suficientes. Preciso sair daqui agora."
  textoConclusaoFase2: "Descobri a falsifica\xE7\xE3o! O Dr. Elias est\xE1 no escrit\xF3rio."
  textoInicioFase3: "O leil\xE3o ilegal j\xE1 come\xE7ou. A seguran\xE7a est\xE1
    m\xE1xima. Preciso encontrar o Servidor e cortar a transmissao e a energia para
    criar uma oportunidade."
  textoAposApagarLuz: "Escurid\xE3o total! O sistema caiu. \xC9 agora! Tenho que
    render o Dr. Elias antes que a luz volte."
  falaDaPrisao: "Acabou, Doutor. As luzes se apagaram para o seu show. A pol\xEDcia
    j\xE1 cercou o pr\xE9dio e suas falsifica\xE7\xF5es foram expostas."
  luzesApagadas: 0
  tempoDeInvencibilidade: 2

MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 970740869}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 78cd3638e4909de4cbcf6c1b06fa47ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodexManager
  allEntries:
  - idNames:
    - Vaso Grande Antigo Corrompido
    title: Vaso Grande Antigo Corrompido
    description: "T\xEDtulo: Vaso Cer\xE2mico de Transi\xE7\xE3o. \r\nCultura: Civiliza\xE7\xE3o
      Ind\xEDgena do Cear\xE1, ~1000 d.C. Apresenta transi\xE7\xE3o do estilo geom\xE9trico
      para o zoomorfo."
    isUnlocked: 0
  - idNames:
    - Vaso Grande Antigo Rosa
    title: Vaso Grande Antigo Rosa
    description: "T\xEDtulo: Vaso Utilit\xE1rio (Fase P\xF3s-Cl\xE1ssica). \r\nCor:
      Atingida por queima em alta temperatura, tonalidade de argila rara no acervo
      local."
    isUnlocked: 0
  - idNames:
    - Vaso Pequeno Prata
    - Vaso Pequeno Rosa
    - Vaso Pequeno Bronze
    - Vaso Pequeno Corrompido
    title: Vasos Pequenos (Rosa, Prata, Dourado, Corrompido)
    description: "T\xEDtulo: Vaso Utilit\xE1rio (Fase P\xF3s-Cl\xE1ssica). \r\nCor:
      Atingida por queima em alta temperatura, tonalidade de argila rara no acervo
      local."
    isUnlocked: 0
  - idNames:
    - Ferramentas De Escavacao
    - Ferramentas De Escavacao
    - Ferramentas De Escavacao
    title: Ferramentas De Escavacao
    description: "Detalhes: Utens\xEDlios de escava\xE7\xE3o e an\xE1lise do s\xE9c.
      XX. Incluem uma esp\xE1tula de carbono, uma lupa de LED e um pequeno pincel
      de fibra \xF3tica."
    isUnlocked: 0
  - idNames:
    - "F\xF3sseis Pequenos"
    - "F\xF3sseis Pequenos"
    - "F\xF3sseis Pequenos"
    - "F\xF3sseis Pequenos"
    title: "F\xF3sseis Pequenos (Cabe\xE7as, Pequenos Ossos, Carac\xF3is)"
    description: "Detalhes: Esta vitrine cont\xE9m uma cole\xE7\xE3o de f\xF3sseis
      de baixo valor, mas de alto interesse did\xE1tico. Inclui gastr\xF3podes do
      Permiano e cr\xE2nios de roedores extintos do Pleistoceno."
    isUnlocked: 0
  - idNames:
    - A Grande Onda de Kanagawa
    title: A Grande Onda de Kanagawa
    description: 'Artista/Ano: Hokusai, 1830. Famosa gravura japonesa Ukiyo-e. A
      montanha Fuji aparece ao longe, simbolizando a eternidade em contraste com
      o poder destrutivo da natureza.'
    isUnlocked: 0
  - idNames:
    - A Noite Estrelada
    title: A Noite Estrelada
    description: "Artista/Ano: Vincent van Gogh, 1889. Representa o estado mental
      agitado do artista. A c\xF3pia \xE9 usada para fins educacionais."
    isUnlocked: 0
  - idNames:
    - "Est\xE1tuas de Povos Antigos"
    - "Est\xE1tuas de Povos Antigos"
    - "Est\xE1tuas de Povos Antigos"
    - "Est\xE1tuas de Povos Antigos"
    title: "Est\xE1tuas de Povos Antigos"
    description: "Detalhes: Estatuetas de culturas pr\xE9-colombianas (ex: figuras
      de fertilidade, deidades do vento). Sua data\xE7\xE3o remonta a 800-1200 d.C.,
      representando forte liga\xE7\xE3o com rituais agr\xEDcolas."
    isUnlocked: 0
  - idNames:
    - "Representa\xE7\xE3o do Triceratopo"
    title: "Representa\xE7\xE3o do Triceratopo"
    description: "T\xEDtulo: Triceratops Horridus. \r\nDieta: Herb\xEDvoro. Famoso
      pelos seus tr\xEAs chifres e grande folho \xF3sseo. Este modelo demonstra o
      poder e a fun\xE7\xE3o de defesa dos ceratopsianos."
    isUnlocked: 0
  - idNames:
    - "F\xF3ssil de Argentinossauro"
    title: "F\xF3ssil de Argentinossauro"
    description: "T\xEDtulo: Argentinossauro Huinculensis. \r\nPer\xEDodo: Cret\xE1ceo
      Superior (~95 milh\xF5es de anos). Saur\xF3pode de pesco\xE7o longo, um dos
      maiores dinossauros j\xE1 descobertos. "
    isUnlocked: 0
  - idNames:
    - "Quadros com Esp\xE9cies de Borboleta"
    - "Quadros com Esp\xE9cies de Borboleta"
    - "Quadros com Esp\xE9cies de Borboleta"
    title: "Quadros com Esp\xE9cies de Borboleta"
    description: "Detalhes: Ilustra\xE7\xF5es cient\xEDficas de esp\xE9cies brasileiras
      (ex: Morpho Menelaus). O valor reside na precis\xE3o bot\xE2nica e entomol\xF3gica
      de um artista do s\xE9c. XIX."
    isUnlocked: 0
  codexPanel: {fileID: 1294494709}
  contentArea: {fileID: 1079878206}
  textTemplate: {fileID: 263283071}
